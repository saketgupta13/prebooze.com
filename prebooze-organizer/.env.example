# Same pattern as prebooze-web's VITE_API_URL — leave unset to hit the real
# production API (see src/api/client.ts's default). Point at a local
# prebooze-api instance for dev (use your machine's LAN IP, not localhost,
# when testing on a physical device via Expo Go).
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000/v1
