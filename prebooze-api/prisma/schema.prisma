// Prebooze API — Prisma schema (Phase 1: auth + users)
// Mirrors the User shape the frontend already uses (prebooze-web/src/types.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ElevatedRole {
  organizer
  promoter
  lineup
  venue
}

enum AttendanceVisibility {
  off
  followers
  public
}

// guest = automatic (ID doc + selfie, vendor-checked); the elevated roles are
// always manual — a human on the team reviews every submission (see BACKEND.md).
enum KycKind {
  guest
  organizer
  promoter
  lineup
  venue
}

enum KycStatus {
  pending // guest: auto-check running or fell back to manual; roles: awaiting team review
  approved
  rejected
}

model User {
  id          String   @id @default(cuid())
  phone       String   @unique // "+91 9990001111" (normalized)
  name        String   @default("")
  username    String   @default("")
  email       String   @default("")
  city        String   @default("")
  state       String?
  country     String?
  pincode     String?
  dob         String   @default("")
  gender      String   @default("")
  profession  String   @default("")
  languages   String   @default("")
  bio         String   @default("")
  socials     String   @default("") // legacy free-text field, superseded by socialLinks below — kept for old rows, no longer written by the forms
  // Per-platform links (instagram/x/facebook/youtube/linkedin/snapchat/tiktok)
  // — replaces the single free-text `socials` blob so a guest can add more
  // than one link without cramming them into one input.
  socialLinks Json     @default("{}")
  interests   String[] @default([])
  avatarUrl   String?

  phoneVerified Boolean @default(true)
  idVerified    Boolean @default(false)
  profilePct    Int     @default(20)
  blocked       Boolean @default(false) // admin action — see AdminCustomersController; enforced at booking creation

  // one number = one elevated role (enforced in service layer too).
  // `role` is only ever set by an admin approving a KycSubmission — never
  // directly by the user — so it doubles as "is this role actually live".
  role             ElevatedRole?
  roleStatus       KycStatus? // null = never applied; mirrors the latest submission's status
  orgBrand         String?
  orgUsername      String?
  // Denormalized from Organizer.logoUrl (kept in sync in OrganizerService.updateMe)
  // so the global header can show it without a second fetch on every page —
  // same reasoning as orgBrand/orgUsername above.
  orgLogoUrl       String?
  lineupName       String?
  lineupCategory   String?
  lineupUsername   String?
  // Denormalized from Lineup.logoUrl (kept in sync in LineupService.updateMe
  // and at KYC approval) — same reasoning as orgLogoUrl/venueLogoUrl above.
  lineupLogoUrl    String?
  promoterBrand    String?
  promoterUsername String?
  promoterPlan     String?
  // Denormalized from Promoter.logoUrl (kept in sync in PromoterService.
  // updateMe) — same reasoning as orgLogoUrl/venueLogoUrl/lineupLogoUrl above.
  promoterLogoUrl  String?
  venueName        String?
  venueId          String?
  // Denormalized from Venue.logoUrl (kept in sync in VenueService.onboard/
  // updateListing) — same reasoning as orgLogoUrl above: lets the global
  // header show it without a second fetch on every page.
  venueLogoUrl     String?

  attendanceVisibility AttendanceVisibility @default(off)
  autoRenew            Boolean              @default(false)

  // deterministic from phone ("PB" + base36 of the last 8 digits) — set once
  // at first login, see AuthService — lets /referrals/claim resolve a code
  // straight to its owner without scanning every user
  referralCode String? @unique

  // Set once, the first time a guest finishes the full (soft-required)
  // profile — see AuthService.claimProfileCompletionReward. profileRewardCode
  // is stored here (not just on the Coupon row) so the frontend can always
  // re-show "you already claimed X" without a separate lookup, and so a
  // second call to the claim endpoint is a safe no-op instead of minting a
  // second coupon.
  profileRewardClaimedAt DateTime?
  profileRewardCode      String?

  kycSubmissions      KycSubmission[]
  bookings            Booking[]
  walletTxs           WalletTx[]
  waitlistEntries     WaitlistEntry[]
  referralsMade       Referral[]       @relation("Referrer")
  referralJoined      Referral?        @relation("Referee")
  payMethods          PayMethod[]
  follows             Follow[]
  eventInterests      EventInterest[]
  eventWishlists      EventWishlist[]
  venueFavourites     VenueFavourite[]
  orgReviews          OrgReview[]
  venueReviews        VenueReview[]
  organizerProfile    Organizer? // set once this user's organizer KYC is approved
  carts               Cart[]
  promoterProfile     Promoter? // set once this user's promoter KYC is approved
  lineupProfile       Lineup? // set once this user's lineup KYC is approved
  venueProfile        Venue? // set once this user's venue onboarding submission creates the row (not at approval — see Venue.userId)
  helpTickets         HelpTicket[]
  orgStaffMemberships OrgStaff[] // organizer team invites this phone has accepted (possibly more than one org)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KycSubmission {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id])
  kind   KycKind
  status KycStatus @default(pending)

  // role-specific fields captured at submission time (brand name, GSTIN,
  // bank account + IFSC, etc.) — free-form so each role's form can differ
  payload Json @default("{}")

  // uploaded file references: [{ "type": "id_doc" | "selfie" | "license" | ..., "path": "..." }]
  documents Json @default("[]")

  // set on the guest path by the (currently dev-stub) auto-check
  autoScore Int?

  reviewedBy String? // admin user id/email — manual reviews only
  reviewNote String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
}

// ============================================================================
// Phase 2 — Catalog (read-only discovery world). Mirrors prebooze-web's
// src/data/mock.ts shapes exactly so the seed script is a straight port and
// the frontend's src/api/index.ts `catalog` group can swap to these with no
// response-shape changes.
// ============================================================================

enum EventStatus {
  approved
  pending
  rejected
  draft
}

enum FeaturedType {
  event
  organizer
  promoter
  lineup
  venue
}

enum FeaturedStatus {
  pending
  active
  rejected
  expired
}

enum FeaturedBilling {
  per_event
  monthly
}

model Venue {
  id          String   @id // slug-style id, e.g. "arena-hall" — matches existing frontend ids
  name        String
  verified    Boolean  @default(false)
  type        String
  locality    String   @default("")
  city        String
  // Same shape as Organizer/Lineup's country/state/pincode — added later
  // than those two, so existing venues simply have these unset until the
  // owner (or admin) fills them in. Unlike city, these carry no directory-
  // matching consequence, so they're freely self-editable with no gate.
  state       String?
  country     String?
  pincode     String?
  // City changes are gated (see VenueService.updateListing) — a self-serve
  // city edit lands here instead of overwriting `city` directly, and an
  // admin must approve it before it takes effect. null = no pending request.
  pendingCity String?
  address     String
  capacity    Int
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  followers   Int      @default(0)
  amenities   String[] @default([])
  about       String
  timings     String?
  photoHue    Int
  events      Event[]

  // Same pattern as Organizer/Promoter/Lineup.userId — added for symmetry
  // (this was previously the one elevated role with no forward FK; ownership
  // ran only through the reverse User.venueId scalar, forcing a `findFirst`
  // instead of `findUnique` in SubscriptionsService.ownerEmail). Set once at
  // VenueService.onboard() time, same as when the row itself is created —
  // venue's catalog row exists (unverified) from submission, not approval,
  // unlike organizer/promoter/lineup, so there's no separate approval-time
  // linking step the way KycService.approve does for those three.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // admin/directory-CRUD-slice additions. `license` is the operating-license
  // reference — compliance data, kept out of the public catalog select
  // below, same reasoning as Organizer.gstin/pan/bankLast4.
  license String?
  contact String?
  rules   String?
  seo     Json?

  // Same admin-only-vs-public split as Organizer.contactPerson/phone/
  // socialLinks above: contactPerson/contactPersonPhone are never in the
  // public catalog select (a private line to the venue's own staff, not
  // guest-facing); socialLinks is public, same {instagram?, facebook?,
  // other?: string[]} shape.
  contactPerson      String?
  contactPersonPhone String?
  socialLinks        Json?

  // Real photo gallery — venue's own upload (POST /venue/upload), shown on
  // the public venue page and to organizers picking a venue at event
  // creation. Unlike photoHue (the placeholder every venue always has),
  // this is optional and empty until the venue owner uploads something.
  galleryUrls String[] @default([])

  // Real logo upload (same POST /venue/upload) — distinct from galleryUrls
  // (interior/event photos): this is the small brand mark shown next to the
  // venue name in the directory and on the public profile, same role
  // Organizer.logoUrl plays for organizers.
  logoUrl String?

  // ---- venue-hosted events (opt-in, admin-gated) ----
  // false for every venue by default and forever unless they explicitly
  // apply and an admin approves it (see VenueHostingRequest) — the venue's
  // own dashboard shows zero hosting UI while this is false. Once true,
  // the venue can create events directly (solo or with a collaborating
  // organizer) the same way an organizer creates one today.
  hostingEnabled     Boolean               @default(false)
  hostingRequestedAt DateTime?
  hostingRequests    VenueHostingRequest[]
  ledger             VenueLedgerTx[]

  // Payout bank details — same plaintext-on-admin-view precedent as
  // Organizer.bankLast4/bankAccountNumber/etc (no field-level encryption
  // anywhere in this schema). Only meaningful once hostingEnabled — a
  // venue that never hosts never needs these, hence fully optional.
  bankLast4         String?
  bankName          String?
  bankAccountNumber String?
  accountHolderName String?
  ifsc              String?

  lead Lead?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * A venue's application to enable event hosting — reviewed by admin, not
 * auto-approved, because (per product decision) most venues don't know the
 * hosting rules/process upfront. `contactedAt` gates Approve in the admin
 * UI: an admin ticks this only after actually reaching out and confirming
 * the venue understands what they're signing up for, so Approve can't be a
 * blind rubber-stamp. Deliberately its own small model rather than reusing
 * KycSubmission — this isn't a new-role application (the venue already
 * exists and is verified), it's a capability toggle on an existing role,
 * and KycService.approve()'s job is provisioning brand-new
 * Organizer/Promoter/Venue/Lineup rows, which has nothing to do with this.
 */
model VenueHostingRequest {
  id          String    @id @default(cuid())
  venueId     String
  venue       Venue     @relation(fields: [venueId], references: [id])
  status      String    @default("pending") // pending | approved | rejected
  contactedAt DateTime? // admin's "Contacted ✓" — Approve is blocked until this is set
  reviewedBy  String?
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
}

/**
 * Real ledger for a venue's own hosted events — same shape and role as
 * OrganizerLedgerTx, just credited to the venue instead of an organizer.
 * Only ever written to for events where Event.hostedByVenue is true; an
 * organizer-booked event at this venue (hostedByVenue false) never touches
 * this — that revenue still credits the organizer's own ledger, completely
 * unchanged. If the venue is collaborating with an organizer on a hosted
 * event, the full net amount still lands here (the venue is the platform's
 * ledger-of-record for its own hosted events) — splitting it with the
 * collaborating organizer happens offline between them, same self-attested
 * pattern as promoter↔organizer settlement (PromoterEventSettlement) —
 * Prebooze only ever tracks its own commission, never that split.
 */
model VenueLedgerTx {
  id         String   @id @default(cuid())
  venueId    String
  venue      Venue    @relation(fields: [venueId], references: [id])
  type       String // sale | refund | withdrawal
  amount     Int // + credit, - debit
  eventId    String?
  eventTitle String?
  note       String?
  createdAt  DateTime @default(now())
}

// Real venue reviews — same shape as OrgReview, previously the one elevated
// role whose ReviewsSection ran entirely on local mock state (no backend at
// all). rating/reviewCount above are recomputed from these rows the same
// way SocialService.addReview does for Organizer.
model VenueReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  venueId   String
  rating    Int
  text      String
  createdAt DateTime @default(now())
}

model Organizer {
  id           String  @id
  brandName    String
  username     String  @unique
  verified     Boolean @default(false)
  city         String
  // Full location, same fields Onboarding.tsx's LocationPicker already
  // collects — only city used to be persisted, silently dropping
  // country/state/pincode even though the applicant filled them in.
  country      String?
  state        String?
  pincode      String?
  since        String
  rating       Float   @default(0)
  reviewCount  Int     @default(0)
  eventsHosted Int     @default(0)
  followers    Int     @default(0)
  following    Int     @default(0)
  about        String
  logoHue      Int
  // Real, uploaded logo (POST /organizer/upload) — optional, falls back to
  // the logoHue placeholder when unset. Same real-upload-over-hue-placeholder
  // move as Venue.galleryUrls / Event.posterUrl.
  logoUrl      String?
  events       Event[]

  // links this catalog row to the real User who owns the console — created
  // automatically the moment their organizer KYC is approved (see
  // KycService.approve). Seeded demo organizers (livewire, nightowl, ...)
  // have no owning user, hence optional.
  userId  String?             @unique
  user    User?               @relation(fields: [userId], references: [id])
  coupons Coupon[]
  ledger  OrganizerLedgerTx[]
  roles   OrgRole[]
  staff   OrgStaff[]

  // admin-only business/compliance fields — prebooze-admin's Organizer type
  // (src/types.ts) has no equivalent in the pre-Admin-API schema; added for
  // the directory CRUD slice. contact/contactPerson/phone/gstin/pan are
  // never shown on the public catalog response; socialLinks IS public (it's
  // meant for guests to find the organizer's real socials).
  contact           String  @default("") // business contact email
  contactPerson     String?
  phone             String?
  eventTypes        String?
  // {instagram?, facebook?, other?: string[]} — structured, so the public
  // profile can render a real Instagram/Facebook icon instead of guessing
  // from a freeform delimited string.
  socialLinks       Json?
  seo               Json?
  lead              Lead?

  // Payout bank accounts — plural, self-serve, no admin review (see
  // PaymentProfile). PAN/GSTIN moved here too, since they're properties of
  // the payout entity, not the organizer brand. `verified` above is identity
  // KYC only (Aadhaar + selfie) and is completely independent of these —
  // withdraw() only requires a default PaymentProfile to exist.
  paymentProfiles PaymentProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A bank account + business identity an organizer can withdraw to. Plural by
// design (an organizer may invoice/get paid under more than one legal
// entity) — self-serve CRUD, no admin approval, unlike identity verification
// (KycSubmission/Organizer.verified). Same plaintext-on-admin-view precedent
// as the rest of this schema (no field-level encryption). bankLast4 is the
// masked value shown back to the organizer; bankAccountNumber is the real
// number, only ever surfaced to admin/staff for actually processing a payout.
model PaymentProfile {
  id          String    @id @default(cuid())
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id])
  isDefault   Boolean   @default(false)

  legalName       String // Company / Firm / LLP / Individual name
  businessAddress String
  country         String?
  state           String?
  city            String?
  pincode         String?

  bankAccountNumber String
  bankLast4         String
  accountHolderName String
  ifsc              String
  branch            String?

  pan   String
  gstin String?
  noGst Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Organizer sales pipeline — every account Prebooze staff has reached out to
// pre-signup, regardless of channel (Instagram, WhatsApp, a phone call, a
// referral, a walk-in at their own event, the website inquiry form, ...).
// `organizerId` is filled in manually by staff once the lead actually signs
// up and completes KYC (no reliable automatic match — a lead's IG handle or
// scribbled phone number isn't guaranteed to match what they sign up with),
// which is what makes "which source actually converts" answerable later.
model Lead {
  id            String    @id @default(cuid())
  name          String
  // Which sales pipeline this lead belongs to — decides which directory
  // search/link endpoint and onboarding link applies (see LeadsService).
  // Defaults to 'organizer' so every pre-existing row (created before this
  // field existed) keeps behaving exactly as it did.
  role          String    @default("organizer") // organizer | venue | promoter | lineup
  source        String // 'Instagram' | 'WhatsApp' | 'Phone call' | 'Referral / walk-in' | 'Website inquiry' | 'Other social' | 'Other'
  contact       String?
  // A second number for the same person — sales sometimes has two (a
  // personal number and a brand/business one, or an old number that still
  // rings). Free-form like `contact`, same reasoning (see
  // lead-phone-match.util.ts): not every value here is guaranteed to be a
  // clean single phone number.
  alternateContact String?
  email         String?
  contactPerson String?
  country       String?
  state         String?
  city          String?
  eventType     String?
  stage         String    @default("New") // New | Contacted | Interested | Negotiating | Signed up | Declined
  followUpAt    DateTime?
  followUpDone  Boolean   @default(false)
  // Set once the automated "you started but didn't finish" WhatsApp nudge
  // (LeadsService.sendAutoNudges) has gone out for this lead — distinct
  // from followUpAt/followUpDone above, which are a staff member's own
  // manually-scheduled reminder, not a system-sent message. Never reset;
  // one nudge per draft lead, ever.
  autoNudgeSentAt DateTime?

  assignedToId String?
  assignedTo   Staff?     @relation(fields: [assignedToId], references: [id])
  organizerId  String?    @unique
  organizer    Organizer? @relation(fields: [organizerId], references: [id])
  // One of venueId/promoterId/lineupId is set once a non-organizer lead
  // actually signs up — same manual staff-picked-match reasoning as
  // organizerId above, just one column per pipeline rather than a
  // polymorphic refId, to keep real FK integrity and Prisma relation
  // includes exactly like the existing organizer link already has.
  venueId      String?    @unique
  venue        Venue?     @relation(fields: [venueId], references: [id])
  promoterId   String?    @unique
  promoter     Promoter?  @relation(fields: [promoterId], references: [id])
  lineupId     String?    @unique
  lineup       Lineup?    @relation(fields: [lineupId], references: [id])

  activities LeadActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

model Promoter {
  id             String   @id
  slug           String   @unique
  name           String
  verified       Boolean  @default(false)
  city           String
  // Full location, same fields Onboarding.tsx's LocationPicker already
  // collects for Organizer/Lineup/Venue — Promoter never got these columns,
  // so country/state/pincode the applicant filled in at onboarding landed
  // nowhere. See newPromoterRow in kyc.service.ts.
  country        String?
  state          String?
  pincode        String?
  bio            String
  // Real, uploaded logo (POST /promoter/upload) — optional, falls back to
  // the hue placeholder when unset, same real-upload-over-hue-placeholder
  // move as Organizer.logoUrl/Venue.galleryUrls.
  logoUrl        String?
  links          String[] @default([])
  followers      Int      @default(0)
  eventsPromoted Int      @default(0)
  guestsBrought  Int      @default(0)
  showRate       Int      @default(0) // % of guests who actually arrived

  // same pattern as Organizer.userId (Phase 6) — provisioned automatically
  // when this user's promoter KYC is approved, see KycService.approve.
  // Seeded demo promoters have no owning user, hence optional.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])
  planId String  @default("free") // SUB_TIERS id — free|starter|pro|elite

  team        PromoterTeamMember[]
  withdrawals PromoterWithdrawal[]
  settlements PromoterEventSettlement[]

  contact String? // business contact email — public, added for the directory CRUD slice
  seo     Json? // {title, description, keywords} — same shape/editor (SeoFields) as every other directory entity; was missing here despite Venue/Organizer having it

  // Collected at onboarding (PromoterOnboarding.tsx) but never persisted
  // anywhere before — editable afterward from Settings, same gap this closes.
  audienceReach String? // free-text reach claim, e.g. "8k on Instagram, 2k WhatsApp broadcast"

  // Full payout bank details — same plaintext-on-admin-view precedent as
  // Organizer.bankLast4/bankAccountNumber/etc (no field-level encryption
  // anywhere in this schema). bankLast4 is the masked value shown back to
  // the promoter themselves; bankAccountNumber is the real number, surfaced
  // to the organizer who actually owes this promoter money for a specific
  // event (they wire it manually — no split-payment rail exists) and to
  // admin/staff.
  bankLast4         String?
  bankName          String?
  bankAccountNumber String?
  accountHolderName String?
  ifsc              String?

  lead Lead?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lineup {
  id           String   @id
  slug         String   @unique
  name         String
  category     String
  verified     Boolean  @default(false)
  city         String
  state        String?
  country      String?
  pincode      String?
  bio          String
  logoUrl      String?
  links        String[] @default([])
  followers    Int      @default(0)
  eventsPlayed Int      @default(0)
  hue          Int
  emoji        String
  seo          Json? // {title, description, keywords} — same shape/editor (SeoFields) as every other directory entity; was missing here despite Venue/Organizer having it

  // same pattern as Organizer/Promoter.userId (Phases 6-7) — provisioned
  // automatically when this user's lineup KYC is approved, see
  // KycService.approve. Seeded demo lineups have no owning user, hence optional.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  lead Lead?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Person {
  id        String   @id
  name      String
  username  String   @unique
  city      String
  avatarHue Int
  bio       String?
  verified  Boolean  @default(false)
  followers Int      @default(0)
  follows   String[] @default([]) // static seed graph only — real follows live in the Follow model (Phase 5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model City {
  name    String  @id
  icon    String?
  top     Boolean @default(false) // shows in the Top-12 picker — max 12, enforced in AdminLocationsService
  sort    Int     @default(0)
  enabled Boolean @default(true) // Admin API locations slice — disabled cities drop out of the public GET /cities

  // Optional link into the Country/State admin-management hierarchy below.
  // Deliberately not the FK every other model uses for "city" (User.city,
  // Venue.city, Organizer.city, ...) — those stay plain strings; changing
  // that would touch nearly every model for no real benefit. This hierarchy
  // is purely an admin-organizing overlay on top of the same flat City rows
  // everything else already references by name.
  stateId String?
  state   State?  @relation(fields: [stateId], references: [id], onDelete: SetNull)
}

model Country {
  id      String  @id @default(cuid())
  name    String  @unique
  enabled Boolean @default(true)
  states  State[]
}

model State {
  id        String  @id @default(cuid())
  name      String
  enabled   Boolean @default(true)
  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities    City[]

  @@unique([countryId, name])
}

model TrendingSearch {
  term String @id
  sort Int    @default(0)
}

// Master list of venue "type" tags (e.g. Nightclub, Rooftop, Warehouse) —
// Venue.type itself stays the existing plain comma-joined string (changing
// that to a real relation would touch every venue-directory read), this is
// the real, admin-managed vocabulary those comma-joined values are picked
// from, replacing the free-text venue-type input with a real multi-select
// and giving each tag a real "N events at this type of venue" count.
model VenueType {
  name String  @id
  icon String?
  sort Int     @default(0)
}

model Event {
  id                  String                    @id
  slug                String                    @unique
  title               String
  description         String
  category            String
  subCategory         String?
  ageLimit            String
  tags                String[]                  @default([])
  date                DateTime
  durationHrs         Float
  // Optional — an organizer running a secret/guest-list-only event can skip
  // registering a real Venue partner entirely and instead set privateCity/
  // privateLocality below. Guests then only ever see "{locality}, {city}",
  // never a linked venue profile or street address; the organizer is
  // responsible for telling booked guests the real address themselves
  // (see Attendees.tsx export). Exactly one of venueId or
  // privateCity+privateLocality is set — enforced in OrganizerService.saveEvent.
  venueId             String?
  venue               Venue?                    @relation(fields: [venueId], references: [id])
  privateCity         String?
  privateLocality     String?
  // Nullable as of the venue-hosting feature — every event before that had
  // exactly one required organizer, and that's still true whenever
  // hostedByVenue is false (the overwhelming majority of events, unchanged
  // forever). Null only when a venue is hosting solo; set even when
  // hostedByVenue is true if the venue picked a collaborating organizer.
  organizerId         String?
  organizer           Organizer?                @relation(fields: [organizerId], references: [id])
  // true = venueId is the actual host/owner of this event (via
  // VenueService), not just a location an organizer booked. Determines
  // which ledger gets credited and who the public "hosted by" line
  // credits. @default(false) — every existing event stays exactly as it
  // is; this is opt-in and additive only.
  hostedByVenue       Boolean                   @default(false)
  status              EventStatus               @default(pending)
  rejectionReason     String?
  conditions          String[]                  @default([])
  rules               Json                      @default("[]") // PartyRule[] — {title, body}[]
  lineup              Json                      @default("[]") // LineupItem[] — {name, role}[]
  posterHue           Int
  seo                 Json? // {title, description, slug, keywords}
  promoterConfig      Json? // PromoterConfig — see prebooze-web/src/types.ts
  // Real media, all optional — a guest-facing gallery + teaser reel, and
  // shareable promo images sized for Instagram (post 1:1 / story 9:16).
  // Real, persisted file URLs (admin/media/upload), same as posterUrl.
  galleryUrls         String[]                  @default([])
  teaserVideoUrl      String?
  socialBanners       Json? // {postUrl?, storyUrl?} — real uploaded image URLs
  tiers               TicketTier[]
  bookings            Booking[]
  waitlistEntries     WaitlistEntry[]
  carts               Cart[]
  promoterGuests      PromoterGuest[]
  guestListEntries    GuestListEntry[]
  checkInLogs         CheckInLog[]
  promoterSettlements PromoterEventSettlement[]
  teamSettlements     PromoterTeamSettlement[]

  // Reports slice (Admin API 9). Finally backs the "Event commission (per
  // event)" permission module that's existed since the staff-auth slice with
  // no endpoint — null means no take-rate set yet (mirrors OrganizerLedgerTx's
  // documented "no commission modeled" placeholder; this is that placeholder
  // becoming real, per-event and opt-in rather than a platform-wide default).
  // paidOut is a reports-only flag for whether this event's organizer payout
  // has gone out — independent of the organizer's own withdraw flow
  // (OrganizerLedgerTx), which already lets them pull their full subtotal
  // regardless of this flag.
  commission Int?
  paidOut    Boolean @default(false)

  // Guest list / Live monitor slice (Admin API 10). "Pause gate sales" in the
  // mock's ops screen — mapped onto the only real sales channel this backend
  // has (online booking, no separate walk-up/gate channel is modeled) —
  // enforced in BookingsService.priceHold(), shared by quote() and create().
  salesPaused Boolean @default(false)

  // Payments/payout-batch slice. posterUrl is the real image reference
  // behind EventEditor's poster-upload toggle (same "give it something
  // real to hold" move as Banner.imageUrl in the CMS slice) — the gallery
  // photos / social banners / teaser reel toggles on the same page are real
  // too now (galleryUrls/teaserVideoUrl/socialBanners above). payoutUtr is
  // set once by a payout batch.
  posterUrl String?
  payoutUtr String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Admin's own free-entry list per event — artists, press, promoters and VIPs
 * who skip tickets entirely. Separate from PromoterGuest (Phase 7's
 * promoter-driven guest capture, which does consume a per-head payout
 * budget) — this is staff-added, no payout implications, doesn't touch
 * ticket inventory.
 */
model GuestListEntry {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id])
  name       String
  phone      String
  plusOnes   Int      @default(0)
  companions Json     @default("[]") // {name, phone}[]
  addedBy    String
  arrived    Boolean  @default(false)
  createdAt  DateTime @default(now())
}

/**
 * Every gate check-in attempt, success or rejection — written by
 * BookingsService.checkIn() on every branch. Didn't exist before the Live
 * Monitor slice; without it, "rejected QRs" and the gate feed would have had
 * nothing real to read from (the mock's own LiveMonitor.tsx admits this:
 * "Feed is simulated locally until the check-in websocket exists"). eventId
 * is nullable only for the one branch where a QR fails JWT verification
 * before any booking can be resolved, so which event it belonged to is
 * genuinely unknown.
 */
model CheckInLog {
  id        String   @id @default(cuid())
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id])
  bookingId String?
  ok        Boolean
  reason    String
  guestName String?
  tierName  String?
  headcount Int      @default(1)
  createdAt DateTime @default(now())
}

/**
 * Platform-wide financial config — singleton row (id "main"). Previously
 * hardcoded (FEE_PER_TICKET in bookings.service.ts, no GST modeling at all);
 * made real for the Reports slice so admin-editable settings actually drive
 * both new bookings' fee and the Reports P&L's GST line, instead of Reports
 * silently guessing at numbers nothing else in the system uses.
 */
model PlatformSettings {
  id         String @id @default("main")
  bookingFee Float  @default(1.5) // ₹ per ticket — matches the pre-existing FEE_PER_TICKET constant exactly
  gstPct     Int    @default(18)

  // Branding — admin-uploaded overrides for the wordmark logo (guest site
  // header/footer/login, admin panel, transactional emails) and the browser
  // favicon. Null means "use the static asset shipped in each app's public/
  // folder" — every consumer already has that fallback baked in, so this
  // column starting empty never breaks anything that worked before it existed.
  logoUrl    String?
  faviconUrl String?

  // Settings slice (Admin API 11) — the rest of prebooze-admin's Settings
  // page. feeLabel/absorbedBy are display-only (no consumer reads them
  // yet — same "give it something real to hold" reasoning as elsewhere).
  // maintenanceMode and salesPaused (the platform-wide "Pause all ticket
  // sales", distinct from the per-event Event.salesPaused) are enforced for
  // real in BookingsService.priceHold().
  feeLabel        String  @default("Convenience fee")
  absorbedBy      String  @default("Organizer") // Organizer | Guest | Split
  payoutDay       String  @default("Friday")
  autoPayout      Boolean @default(true)
  weeklyEmail     Boolean @default(true)
  whatsappAlerts  Boolean @default(true)
  require2fa      Boolean @default(false)
  maintenanceMode Boolean @default(false)
  salesPaused     Boolean @default(false)
  // Soft-launch gate — distinct from maintenanceMode (a temporary outage
  // toggle for everyone, no bypass): comingSoonMode shows the public a
  // "coming soon" page while staff can still see the real site by logging
  // in with real staff credentials on the guest site itself (ComingSoonGate
  // in prebooze-web, same POST /admin/auth/login staff-auth used elsewhere).
  comingSoonMode  Boolean @default(false)
  socials         Json    @default("{\"instagram\":\"\",\"x\":\"\",\"youtube\":\"\",\"whatsapp\":\"\",\"facebook\":\"\"}")
  siteSeo         Json    @default("{\"title\":\"\",\"description\":\"\",\"keywords\":\"\"}")
  contact         Json    @default("{\"email\":\"\",\"phone\":\"\",\"address\":\"\",\"organizerEmail\":\"\"}")
  footerCopyright String  @default("")

  // Referrals admin slice — these were hardcoded constants
  // (REFERRAL_REFEREE_WELCOME / REFERRAL_REFERRER_REWARD) with no admin
  // control at all; now the single source of truth both the referral
  // service and the "Refer & earn" analytics page read from.
  referralReferee  Int @default(100)
  referralReferrer Int @default(100)

  // Featured rates slice — FeaturedService's RATES was a hardcoded constant
  // with a public read (GET /featured/rates, already in prebooze-web's
  // contract) but no admin write, flagged in that file's own comment as
  // "separate Admin API work" and never actually built until now.
  featuredPerEvent         Int @default(2000)
  featuredOrganizerMonthly Int @default(4999)
  featuredPromoterMonthly  Int @default(2999)
  featuredLineupMonthly    Int @default(1999)
  featuredVenueMonthly     Int @default(3999)

  updatedAt DateTime @updatedAt
}

/**
 * Subscription tiers — originally promoter-only (PromoterService's
 * PLAN_QUOTA guest-add quota per plan), generalized to also serve
 * organizer/venue/lineup once real Razorpay Subscription billing landed (see
 * RoleSubscription below). Existing rows (free/starter/pro/elite) are all
 * `role: promoter`, untouched — `Promoter.planId` still reads `SubTier.guests`
 * directly for the guest-list quota hot path, same as before. Organizer/venue/
 * lineup have zero seeded tiers as of this migration — nothing invents
 * pricing for them; real tiers get added via `admin/sub-tiers` once the
 * business side has real numbers. Lineup previously had no self-serve
 * console/module at all (KYC-only — see DirectoryService); a minimal one
 * (`src/lineup/`) was added specifically to carry these subscription routes,
 * same shape as organizer/promoter/venue's.
 */
enum SubTierRole {
  organizer
  promoter
  venue
  lineup
}

model SubTier {
  id             String      @id
  role           SubTierRole @default(promoter)
  name           String
  price          Int // ₹/month
  guests         Int? // promoter-only monthly guest-list quota (-1 = unlimited); null for other roles
  razorpayPlanId String? // lazily created via RazorpayService.createPlan on first real subscribe — a plan is only created with Razorpay once someone actually tries to pay for this tier

  subscriptions RoleSubscription[]
}

/**
 * One row per role-entity's current subscription lifecycle, backed by a
 * real Razorpay Subscription once price > 0. `status` mirrors Razorpay's own
 * subscription states exactly (see RAZORPAY.md / RazorpaySubscriptionService)
 * — driven by the webhook handler, never set optimistically at request time,
 * so a tier only actually takes effect once payment is genuinely
 * authorized/charged. Free tiers (price 0) skip Razorpay entirely and go
 * straight to `active`.
 */
enum SubscriptionStatus {
  created
  authenticated
  active
  pending
  halted
  cancelled
  completed
  expired
}

model RoleSubscription {
  id            String               @id @default(cuid())
  role          SubTierRole
  entityId      String // Organizer.id | Promoter.id | Venue.id
  tierId        String
  tier          SubTier              @relation(fields: [tierId], references: [id])
  razorpaySubId String?              @unique
  status        SubscriptionStatus   @default(created)
  shortUrl      String? // hosted Razorpay authorization link the frontend redirects the owner to
  currentStart  DateTime?
  currentEnd    DateTime?
  paidCount     Int                  @default(0)
  charges       SubscriptionCharge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, entityId]) // one subscription record per role-entity at a time
}

/**
 * Real billing history — one row per `subscription.charged` webhook,
 * regardless of whether the charge succeeded (status lets admin see a
 * failed renewal attempt, not just successful ones).
 */
model SubscriptionCharge {
  id                String           @id @default(cuid())
  subscriptionId    String
  subscription      RoleSubscription @relation(fields: [subscriptionId], references: [id])
  razorpayPaymentId String?
  amount            Int // ₹
  status            String // captured | failed
  occurredAt        DateTime         @default(now())
}

/**
 * Real system-event feed for the admin bell icon — event submitted for
 * approval, refund requested, role KYC submitted. `read` is a single shared
 * flag (a small-team shared inbox, matching the mock exactly — no per-staff
 * read receipts). Deliberately doesn't cover every notification type the
 * mock shows: "license expires" has no expiry field anywhere on Venue, and
 * "blog goes live" has no scheduled-publish concept on Blog — inventing
 * either would be a new field with nothing else in the system backing it.
 */
model AdminNotification {
  id        String   @id @default(cuid())
  icon      String
  text      String
  to        String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TicketTier {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id])
  name        String
  price       Int // ₹, integer
  quantity    Int
  sold        Int      @default(0)
  includes    String[] @default([])
  description String?
}

model Featured {
  id        String          @id @default(cuid())
  type      FeaturedType
  refId     String // event id | organizer id | promoter slug | lineup slug | venue id
  city      String
  status    FeaturedStatus  @default(pending)
  billing   FeaturedBilling
  amount    Int
  createdAt DateTime        @default(now())
  expiresAt DateTime

  // Real Razorpay billing — a request isn't payable to admin for approval
  // until `paid` is true (see FeaturedService.confirmPayment/adminApprove).
  razorpayOrderId String?
  paymentId       String?
  paid            Boolean @default(false)
  // GST breakdown at the moment the Razorpay order was created — persisted
  // so the Invoice generated in confirmPayment (only once payment actually
  // clears) reflects exactly what was charged, even if admin changes the
  // platform GST% between request() and confirmPayment().
  gstPct          Float?
  gstAmount       Int?
  total           Int?

  // Automatic "expiring in 3 days" reminder (CronService.featuredExpiringSoonTick)
  // — distinct from the already-expired manual reminder button/endpoint.
  // Null = not yet sent; set once so the daily cron doesn't re-send every day.
  expiryReminderSentAt DateTime?

  // Set only for a row created by an auto-renewing FeaturedSubscription
  // (organizer/promoter/venue/lineup, never 'event' — see that model) —
  // one immutable row per billed period, `status: active`/`paid: true` from
  // the moment it's created since a subscription renewal never goes through
  // the pending-admin-approval queue the one-time flow above does. Null for
  // every legacy one-time placement and every per-event placement.
  featuredSubscriptionId String?
  featuredSubscription   FeaturedSubscription? @relation(fields: [featuredSubscriptionId], references: [id])
}

/**
 * A standing Razorpay Subscription (real e-mandate/UPI Autopay, same
 * RazorpayService.createPlan/createSubscription rails already used for
 * organizer/promoter/venue/lineup paid plans — see RoleSubscription) behind
 * one auto-renewing Featured placement. Never used for `type: event` — a
 * one-off event has a fixed date, there's nothing to recur.
 * The rate/GST are locked in at subscribe() time and reused for every
 * renewal, so a later change to the platform's Featured rates never
 * silently changes what an already-subscribed placement gets charged —
 * same reasoning as Booking.promoterCommission being locked in at sale time.
 */
model FeaturedSubscription {
  id            String             @id @default(cuid())
  type          FeaturedType
  refId         String
  city          String
  amount        Int
  gstPct        Float
  gstAmount     Int
  total         Int
  razorpaySubId String?            @unique
  status        SubscriptionStatus @default(created)
  shortUrl      String? // hosted Razorpay authorization link the frontend redirects the owner to
  currentStart  DateTime?
  currentEnd    DateTime?
  paidCount     Int                @default(0)
  periods       Featured[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, refId]) // one standing subscription per featured-able entity
}

// ============================================================================
// Phase 3 — Bookings, holds (Redis, not modeled here — TTL 8 min, see
// bookings/holds.service.ts), waitlist, wallet, referrals, coupons, real QR.
// ============================================================================

enum BookingStatus {
  confirmed
  cancelled
  refunded
  refund_requested // source refunds only — see BookingsService.cancel; wallet refunds go straight to refunded
}

enum RefundMethod {
  wallet
  source
}

model Booking {
  id      String @id // "#TKT-xxxxx"
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  tierName      String // display summary, e.g. "2× General"
  tierBreakdown Json // {tierId: qty} — exact per-tier split, used to restore inventory on cancel
  qty           Int
  subtotal      Int
  fee           Int
  discount      Int    @default(0)
  total         Int

  couponCode String?
  status     BookingStatus @default(confirmed)
  guests     Json // BookingGuest[] — {name, checkedIn, gender?, whatsapp?} (see prebooze-web/src/types.ts)
  mainGuest  String
  whatsapp   String

  promoterRef        String? // promoter slug credited with this sale (affiliate commission)
  // Locked in at booking creation using whatever % was negotiated for this
  // promoter on this event at that moment (Event.promoterConfig.revenueShare)
  // — computed once and stored, not recomputed live, so a later edit to the
  // organizer's negotiated rate never silently changes what a promoter
  // already earned on a past sale. 0 when promoterRef is unset/not a
  // recognised revenue-share promoter for this event.
  promoterCommission Int           @default(0)
  // Sub-promoter handle credited within promoterRef's own team (?via= on the
  // ticket link, same attribution label PromoterGuest.subPromoter already
  // uses for the free-entry side) — purely a tracking tag, doesn't change
  // promoterCommission or any pricing; it's what PromoterTeamMember payout
  // splits are computed against.
  promoterVia        String?
  walletCreditUsed   Int           @default(0)
  paymentId          String? // Razorpay payment id (or dev-stub id — see RazorpayService)
  refundedTo         RefundMethod?

  // Manual/admin booking creation slice — null means "the normal guest
  // checkout flow" (Razorpay/dev-stub, implied by paymentId). Set only for
  // staff-recorded phone orders/walk-ups/comps (BookingsService.adminCreate).
  paymentMethod String?

  qrToken     String // signed JWT — POST /bookings/check-in validates this server-side
  checkedIn   Boolean   @default(false)
  checkedInAt DateTime?

  // CronService.reviewRequestTick — null = not yet sent, set once so the
  // daily tick doesn't re-prompt the same guest every day forever.
  reviewReminderSentAt DateTime?

  createdAt DateTime @default(now())
}

model WaitlistEntry {
  id       String   @id @default(cuid())
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  status   String   @default("waiting") // waiting | offered
  joinedAt DateTime @default(now())

  @@unique([eventId, userId]) // one entry per person per event
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  type          String // percent | flat
  value         Int
  maxDiscount   Int?
  usageLimit    Int
  used          Int      @default(0)
  perUserLimit  Int
  eventScope    String // 'all' or an event title
  validTill     DateTime
  firstTimeOnly Boolean  @default(false)
  status        String   @default("active") // active | paused

  // null = platform-wide promo (e.g. FIRST50, created outside any one
  // organizer's console); set = an organizer's own coupon, in which case
  // "all" scopes to all of *that organizer's* events, not the whole
  // platform — enforced in BookingsService.priceHold, not just here.
  organizerId String?
  organizer   Organizer? @relation(fields: [organizerId], references: [id])

  // Admin API "Promo codes" slice — prebooze-admin's Promo type turned out
  // to be the same concept as a platform-wide Coupon (organizerId null),
  // not a separate system, just with gender-audience targeting added.
  // "all" = no restriction. Enforced in BookingsService.priceHold.
  gender String @default("all")

  // Staff-facing note about what the code is for — shown to staff and on
  // the guest checkout screen, not enforced anywhere.
  description String?
}

/**
 * Admin API "categories" slice — Event.category stays a plain string
 * (same "additive, not a replacement" reasoning as Locations/City) — this
 * is just the reference list that feeds the category picker + each
 * category's own landing-page icon/image/SEO, same pattern as CareerTeam
 * and BlogCategory before it.
 */
model EventCategory {
  name     String   @id
  icon     String   @default("🏷")
  imageUrl String?
  seo      Json?
  // Real sub-category list — previously only the legacy, disconnected
  // `Category` model (now removed) had this; EventCategory is the one real
  // source of truth for the whole category+subcategory tree now (admin
  // CRUD, guest browse/filter, both event editors' pickers).
  subs     String[] @default([])
  sort     Int      @default(0)
}

model WalletTx {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String // welcome | referral_welcome | referral_reward | refund | spend
  amount    Int // negative for spend
  note      String
  createdAt DateTime @default(now())
}

model Referral {
  id         String   @id @default(cuid())
  code       String
  referrerId String
  referrer   User     @relation("Referrer", fields: [referrerId], references: [id])
  refereeId  String   @unique // a phone can only ever be referred once
  referee    User     @relation("Referee", fields: [refereeId], references: [id])
  status     String   @default("joined") // joined | qualified (qualifies on referee's first paid booking)
  createdAt  DateTime @default(now())
}

// ============================================================================
// Phase 4 — Wallet & payments, referrals (the rest of the money-adjacent
// account surface; the wallet ledger itself is written by bookings.service).
// ============================================================================

model PayMethod {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  type      String // upi | card
  label     String // "riya@upi" or "Visa •••• 4242"
  holder    String? // card-holder name
  expiry    String? // MM/YY — CVV is never accepted or stored, see PATCH note in wallet.service.ts
  isDefault Boolean @default(false)
  // Dedup key for auto-saved methods only (manually-added ones via
  // wallet.service.ts's addPayMethod leave this null) — "upi:<vpa>" or
  // "card:<last4>:<network>", the same real Razorpay-returned identity a
  // repeat checkout with the same method will hash to again. Real PANs are
  // never stored, so last4+network is the most specific real match we have.
  matchKey  String?
  usedCount Int     @default(1)

  createdAt DateTime @default(now())

  @@unique([userId, matchKey])
}

// ============================================================================
// Phase 5 — Social. Follows are instant/accepted for every followee type
// (person/organizer/promoter/venue/lineup) — there's no private-account
// gating in this product yet, so the frontend's follow-requests UI (built
// ahead of any real trigger for it) is served by a stub that's honestly
// always empty rather than modeled with a real approval table. See
// social.service.ts and BACKEND.md "Social" for the reasoning.
// ============================================================================

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation(fields: [followerId], references: [id])
  followeeKey String // "person:<id>" | "promoter:<slug>" | "lineup:<slug>" | bare venue/organizer id
  createdAt   DateTime @default(now())

  @@unique([followerId, followeeKey])
}

model EventInterest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  eventId   String
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
}

model EventWishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  eventId   String
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
}

model VenueFavourite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  venueId   String
  createdAt DateTime @default(now())

  @@unique([userId, venueId])
}

model OrgReview {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  organizerId String
  rating      Int
  text        String
  createdAt   DateTime @default(now())
}

// ============================================================================
// Phase 6 — Organizer console: event create/edit (+ the minimal admin
// approve/reject that closes the loop), attendees, coupons, payouts, and
// abandoned-cart recovery.
// ============================================================================

/**
 * One row per hold created (see HoldsService.create) — Redis owns the live
 * TTL/reservation, this is the durable trail that lets abandoned-cart
 * recovery work without a cron: a cart counts as "abandoned" if it's the
 * *most recent* hold for that user+event, still `active`, and older than
 * the hold TTL — evaluated lazily at read time in OrganizerService.carts,
 * not written by a background job.
 */
model Cart {
  id         String    @id @default(cuid())
  holdId     String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id])
  qtyMap     Json // tierId -> qty, mirrors the hold
  subtotal   Int
  total      Int
  status     String    @default("active") // active | completed
  remindedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/**
 * Organizer earnings ledger. Credited with the booking subtotal (not the
 * booking fee, which is platform revenue) when a booking on their event is
 * confirmed, debited on cancellation/refund and on withdrawal. No
 * commission/take-rate is modeled yet — organizers are credited the full
 * ticket subtotal — see BACKEND.md "Organizer" for why that's a deliberate
 * placeholder, not an oversight.
 */
model OrganizerLedgerTx {
  id          String    @id @default(cuid())
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id])
  type        String // sale | refund | withdrawal
  amount      Int // + credit, - debit
  eventId     String?
  eventTitle  String?
  note        String?
  createdAt   DateTime  @default(now())

  // Denormalized snapshot of which PaymentProfile a withdrawal actually paid
  // out to — same "capture the name alongside the id" precedent as
  // eventId/eventTitle above. Needed once profiles are plural: a later edit
  // or deletion of the profile must never change the historical record of
  // where a past payout went. Only set for type:'withdrawal'.
  paymentProfileId        String?
  payoutBankLast4         String?
  payoutAccountHolderName String?
  payoutIfsc              String?
}

// Organizer's own team/permissions system — same view/edit-per-module shape
// as admin's StaffRole/Staff, just organizer-scoped instead of platform-wide
// and with a smaller, organizer-relevant module list. Unlike admin staff
// (separate email+password login), a team member logs in with their own
// phone via the normal guest OTP flow — OrgStaff.userId (below) is what
// links that login to this organizer's console + role, resolved by
// OrgAccessService.
model OrgRole {
  id          String    @id @default(cuid())
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id])
  name        String
  permissions Json // Record<module, {view: bool, edit: bool}>
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([organizerId, name])
}

model OrgStaff {
  id          String    @id @default(cuid())
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id])
  name        String
  phone       String?
  roleName    String
  scan        Boolean   @default(false) // gate-scanner access, independent of the role matrix

  // Real invite-to-login linkage — set immediately at invite time if a User
  // with this phone already exists, otherwise lazily backfilled the next
  // time this phone completes OTP login (see AuthService.verifyOtp). Once
  // set, OrgAccessService resolves this user's organizer-console access via
  // this row + its role's permission matrix, the same way it resolves a
  // real owner — this is what makes "invite member" an actual login path
  // instead of a decorative name label. Not globally unique: the same
  // person can be staff at more than one organizer.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizerId, phone])
  @@index([userId])
}

// ============================================================================
// Phase 7 — Promoter console: guest-list capture + fraud guards, check-in,
// earnings (computed live from PromoterGuest/Booking, not a stored ledger —
// unlike OrganizerLedgerTx, there's nothing here that isn't already
// reconstructible from those two tables), team, subscription.
// ============================================================================

/**
 * A free-entry list signup. Joined to Promoter by slug (not a FK) — same
 * convention as Booking.promoterRef, since a promoter's slug is the join key
 * used everywhere (affiliate links, event.promoterConfig.allowedPromoters).
 */
model PromoterGuest {
  id           String    @id
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id])
  promoterSlug String
  name         String
  phone        String
  age          String
  gender       String
  subPromoter  String? // sub-promoter handle credited within the team (?via=)
  // Party members beyond the main signer — same shape as GuestListEntry.
  // companions (admin's own free list): [{name, phone?}]. One combined QR
  // (still just this row's id) covers the whole party; the gate scans once
  // and `arrived`/`arrivedAt` below flips for everyone together — there's no
  // per-companion arrival state, matching how a single ticket booking's
  // whole guest list already checks in as one unit.
  companions   Json      @default("[]")
  arrived      Boolean   @default(false)
  arrivedAt    DateTime?
  createdAt    DateTime  @default(now())
}

model PromoterTeamMember {
  id                String   @id @default(cuid())
  promoterId        String
  promoter          Promoter @relation(fields: [promoterId], references: [id])
  handle            String
  name              String
  hue               Int
  // % of this member's own tagged earnings (PromoterGuest.subPromoter /
  // Booking.promoterVia matching this handle) the lead intends to pay them
  // — one rate, not renegotiated per event, same "one rate" convention as
  // the lead's own revenueShare with organizers. 0 = not yet configured,
  // tracked/visible but nothing is computed as "owed" until set, same
  // blank-means-not-enabled convention used elsewhere in this schema.
  payoutSplitPct    Int      @default(0)
  // Optional soft cap on this member's own free-entry signups per month —
  // a slice of the lead's own monthly quota, enforced in addition to (not
  // instead of) the lead's overall quota check. null = no separate cap,
  // this member can use up to the lead's full remaining quota like anyone
  // else on the team.
  monthlyQuotaShare Int?
  createdAt         DateTime @default(now())

  settlements PromoterTeamSettlement[]

  @@unique([promoterId, handle])
}

model PromoterWithdrawal {
  id         String   @id @default(cuid())
  promoterId String
  promoter   Promoter @relation(fields: [promoterId], references: [id])
  amount     Int
  createdAt  DateTime @default(now())
}

// Tracks whether a promoter has actually been paid by the organizer for one
// event — a real bank transfer between organizer and promoter happens
// entirely outside Prebooze (no split-payment rail exists, see
// bookings.service.ts/RazorpayService — everything lands in Prebooze's own
// account first), so this is a self-attested confirmation flow, not a
// payment record: the promoter marks 'received' once money actually reaches
// them, or 'reminder_sent' to nudge the organizer via a real WhatsApp/email
// notification. One row per (promoter, event) — matches how organizer's own
// payouts are already settled per-event (Event.paidOut/payoutUtr), not
// per-booking.
model PromoterEventSettlement {
  id             String    @id @default(cuid())
  promoterId     String
  promoter       Promoter  @relation(fields: [promoterId], references: [id])
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id])
  status         String    @default("pending") // pending | reminder_sent | received
  reminderSentAt DateTime?
  receivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([promoterId, eventId])
}

/**
 * A lead promoter's own attestation that they've paid a team member their
 * split for one event — same self-attested shape as PromoterEventSettlement
 * (organizer -> promoter), one level down (promoter -> sub-promoter). The
 * lead marks this, not the sub-promoter, since the lead is the one actually
 * disbursing — a sub-promoter has no login here to attest anything
 * themselves (see PromoterTeamMember — link-only, no userId).
 */
model PromoterTeamSettlement {
  id           String             @id @default(cuid())
  teamMemberId String
  teamMember   PromoterTeamMember @relation(fields: [teamMemberId], references: [id])
  eventId      String
  event        Event              @relation(fields: [eventId], references: [id])
  status       String             @default("pending") // pending | paid
  paidAt       DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([teamMemberId, eventId])
}

// ============================================================================
// Support, careers — Featured itself was already modeled in Phase 2 (the
// read side, GET /featured, has been live since then); this just adds the
// write side plus two small standalone domains with no earlier phase to
// belong to.
// ============================================================================

model HelpTicket {
  id      String  @id
  userId  String?
  user    User?   @relation(fields: [userId], references: [id])
  // Public Contact-us submissions have no logged-in user at all — name/email
  // are captured directly from the form in that case. For a real ticket
  // (userId set), these stay null; the real name/email live on the User row.
  name    String?
  email   String?
  role    String // the caller's User.role at submission time (or "guest"), set server-side — not client input
  topic   String
  subject String
  message String
  status  String  @default("open") // open | resolved

  createdAt DateTime @default(now())
}

model CareerJob {
  id               String           @id @default(cuid())
  title            String
  team             String
  loc              String
  type             String // Full-time | Internship | ...
  status           String           @default("open") // open | closed
  about            String
  responsibilities String[]         @default([])
  requirements     String[]         @default([])
  applications     JobApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobApplication {
  id    String    @id @default(cuid())
  jobId String
  job   CareerJob @relation(fields: [jobId], references: [id])
  name  String
  email String
  phone String
  note  String
  cv    String? // uploaded file URL, via StorageService — optional since not every applicant attaches one

  appliedAt DateTime @default(now())
}

// ============================================================================
// Admin API, slice 1 — real staff/admin authentication + the permission
// matrix, replacing the placeholder x-admin-secret gate (AdminGuard) that
// /admin/kyc, /admin/events and /admin/featured used until now. Mirrors
// prebooze-admin's AdminContext.tsx RoleMatrix/StaffMember shapes — role
// *names* (Owner, Manager, Finance, Content, "Scanner only", or any custom
// name an Owner creates) are the actual permission unit, not the coarse
// admin/staff login-tab distinction, which the mock never actually wires
// into any real enforcement (see BACKEND.md "Admin API").
// ============================================================================

model StaffRole {
  name        String  @id // "Owner", "Manager", "Finance", "Content", "Scanner only", ...
  permissions Json // { [moduleName]: { view: bool, edit: bool, approve: bool } } — see PERM_MODULES in BACKEND.md
  // Whenever a new admin feature ships, it's a new PERM_MODULES entry that
  // no *existing* role row has a key for yet — `permissions` only ever has
  // whatever was explicit at creation/last-edit time. defaultOpen decides
  // what a *missing* module resolves to for this role (see
  // resolvePermissions in permissions.util.ts): true for "broad" roles
  // (Owner, Manager) that are meant to get new features automatically —
  // matching how they were originally seeded, spreading every module on by
  // default — false (the default) for narrow, hand-picked roles (Finance,
  // Content, Support, Scanner, Sales) where a new module should stay
  // invisible until an Owner deliberately opts them in.
  defaultOpen Boolean @default(false)
  staff       Staff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Staff {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String // scrypt salt:hash, see src/admin/password.util.ts — no new dependency for this
  roleName      String
  role          StaffRole @relation(fields: [roleName], references: [name])
  city          String?
  phone         String? // WhatsApp number for staff alerts (refund requests, KYC submissions, payout failures) — see Settings.whatsappAlerts
  lastActiveAt  DateTime?
  leads         Lead[]
  // Which Lead pipelines this person can see/work — 'organizer' | 'venue' |
  // 'promoter' | 'lineup', any combination. Empty (the default) means
  // unrestricted — every existing staff row keeps seeing every lead exactly
  // as before this field existed. A non-empty scope is how a salesperson
  // gets assigned to work only e.g. Venue leads, enforced server-side in
  // LeadsService, not just hidden in the UI.
  leadRoleScope String[]  @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// Admin API, slice 4 — content CMS. Unlike financial records (bookings),
// deleting content is a normal, safe operation — every model here supports
// a real DELETE, unlike the deliberate no-hard-delete stance on bookings.
// `hasImage`/`hasBanner` booleans in the mock are placeholder toggles for a
// real upload flow that doesn't exist yet — stored as an optional image URL
// reference instead, giving a real backend something to actually serve.
// ============================================================================

model Banner {
  id          String  @id @default(cuid())
  title       String
  statusLabel String  @default("")
  heading     String?
  description String?
  ctaLabel    String?
  ctaLink     String?
  imageUrl    String?
  active      Boolean @default(true)
  sort        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogCategory {
  id        String  @id @default(cuid())
  name      String  @unique
  bannerUrl String?
  seo       Json?
}

model Blog {
  id        String  @id @default(cuid())
  title     String
  meta      String  @default("")
  status    String  @default("draft") // published | draft | scheduled
  category  String?
  content   String?
  bannerUrl String?
  seo       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SitePage {
  slug     String  @id
  title    String
  content  String?
  navGroup String?
  seo      Json?

  updatedAt DateTime @updatedAt
}

model Testimonial {
  id       String  @id @default(cuid())
  author   String
  location String
  rating   Int
  quote    String
  featured Boolean @default(false)

  createdAt DateTime @default(now())
}

model FaqItem {
  id       String @id @default(cuid())
  question String
  answer   String
  audience String // guests | organizers
  sort     Int    @default(0)
}

model Policy {
  id       String @id @default(cuid())
  title    String
  slug     String @unique
  sections Json // {heading, body}[]
  seo      Json?

  updatedAt DateTime @updatedAt
}

/**
 * Singleton — one row, id="main". Header nav + footer link groups.
 */
model MenuConfig {
  id     String @id @default("main")
  header Json // MenuLink[] — {label, to}[]
  footer Json // FooterGroup[]

  updatedAt DateTime @updatedAt
}

// Admin API, slice 6 — careers admin. CareerJob/JobApplication already
// existed (the Featured/Support/Careers slice) with a public read + apply
// surface; this just adds the admin write side + a simple reference list
// of valid team names for the job-creation form's dropdown.
model CareerTeam {
  name String @id
}

// Admin API, slice 7 — reels. The mock's Reel type (title/hue/active) has
// no video reference at all, not even a boolean placeholder like Banner's
// old hasImage — this is a "coming soon" content type with no playback
// infra implied anywhere. videoUrl is added anyway, optional, same "give a
// real backend something to hold" reasoning as imageUrl/bannerUrl (slice 4).
model Reel {
  id       String  @id @default(cuid())
  title    String
  hue      Int
  active   Boolean @default(true)
  videoUrl String?
  // First-frame poster, generated server-side at upload time (see
  // StorageService.processVideo) — the guest homepage shows this by default
  // and only fetches the real video once a guest taps to play it, instead
  // of every reel autoplaying and downloading on page load.
  posterUrl String?

  createdAt DateTime @default(now())
}

// ============================================================================
// Admin API, slice 8 — finance ledger. Prebooze's own internal P&L (staff
// salaries, marketing spend, sponsorship income, ...), not to be confused
// with OrganizerLedgerTx (an organizer's per-event earnings, Phase 6) or
// PromoterWithdrawal — this is the platform's own books. The mock's `auto`
// field ("auto-posted, e.g. ticket commission — not editable") is a real
// feature here, not a stub: BookingsService now auto-posts a "Booking
// fees" income entry on every confirmed booking and reverses it as a
// "Refund losses" expense when a refund is finalized — the same instinct
// as the OrganizerLedgerTx sale/refund pair, just for platform fee revenue
// instead of an organizer's ticket revenue.
// ============================================================================

model LedgerEntry {
  id       String  @id @default(cuid())
  kind     String // income | expense
  category String
  amount   Int
  note     String?
  auto     Boolean @default(false) // auto-posted from real activity — never client-editable or deletable
  // Set only on auto-posted, per-event entries (Ticket commission/Booking
  // fees/Refund losses) — lets booking creation upsert-and-increment one
  // running total per (event, category) instead of inserting a fresh row
  // per ticket sold. Null (and unconstrained) on manual entries — the
  // unique index below only applies where eventId is non-null, since
  // Postgres never treats two NULLs as equal in a unique index.
  eventId  String?

  createdAt DateTime @default(now())

  @@unique([eventId, category])
}

model LedgerCategory {
  id   String @id @default(cuid())
  kind String // income | expense
  name String

  @@unique([kind, name])
}

// ============================================================================
// Email templates — admin-editable overrides. `id` is normally the fixed
// template key (e.g. "booking_confirmed") the code already defines a
// hardcoded default for in notifications/email-templates.ts, not a cuid — a
// row here means "admin customized this one," absence means "use the code
// default." Only `subject`/`bodyHtml` are editable (plain {{token}}
// placeholders, resolved by renderTemplate() at send time) — never raw
// executable content, so an admin edit can only change wording/formatting,
// never inject script.
//
// `name`/`category` are set only for *custom* templates — ones admin created
// from scratch (id prefixed "custom_"), not tied to any real trigger in
// code, sent manually. Fixed templates get their name/category from
// TEMPLATE_DEFS and leave these null.
// ============================================================================

model EmailTemplate {
  id        String   @id
  name      String?
  category  String?
  subject   String
  bodyHtml  String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ============================================================================
// Invoices — one row per real payment received (booking) or billable request
// (featured placement) from any role. Numbers are sequential per Indian GST
// invoicing convention (gap-free, unique) via InvoiceCounter's atomic
// increment inside the same transaction as the Invoice create.
// ============================================================================

model InvoiceCounter {
  id    String @id @default("main")
  value Int    @default(0)
}

model Invoice {
  id          String    @id @default(cuid())
  number      String    @unique // "INV-2026-000123"
  type        String // booking | featured
  refId       String // Booking.id or Featured.id
  role        String // guest | organizer | promoter | venue | lineup
  payerName   String
  payerEmail  String?
  payerPhone  String?
  // Business identity snapshot — for a "featured" invoice billed to an
  // organizer, payerName is the individual account holder's name; these are
  // the actual business details (brand, GSTIN, PAN) a real tax invoice
  // should show for the entity being billed, captured at issue time.
  payerBrand  String?
  payerGstin  String?
  payerPan    String?
  city        String?
  description String
  subtotal    Float
  gstPct      Float     @default(0)
  gstAmount   Float     @default(0)
  total       Float
  status      String    @default("issued") // issued | void
  issuedAt    DateTime  @default(now())
  lastSentAt  DateTime?

  @@index([type, refId])
  @@index([role])
  @@index([city])
  @@index([issuedAt])
}

// Booking-funnel visibility — before this, the only way to see where real
// guests were dropping off (viewed → clicked book → logged in → reached
// checkout → opened the payment widget → paid) was to hand-query Cart/
// Booking rows over SSH, which is how the Alok/Chinky investigation
// happened. One row per real step, written by a public, fire-and-forget
// POST /track — never allowed to block or fail the actual user action it's
// observing (see TrackService.record).
model FunnelEvent {
  id        String   @id @default(cuid())
  sessionId String // stable per-browser id (localStorage), set before login so pre-auth drop-off is visible too
  userId    String?
  type      String // event_viewed | book_clicked | otp_requested | otp_verified | checkout_viewed | payment_widget_opened | payment_submitted | booking_completed
  eventId   String? // Event.id, when this step is about a specific event
  meta      Json?
  createdAt DateTime @default(now())

  // Device/browser/OS — parsed server-side from the request's User-Agent
  // header (TrackService.parseUserAgent), never trusted from the client
  // body directly, since a client could send anything there but not fake
  // the header without faking the whole request.
  device  String? // mobile | tablet | desktop
  browser String? // Chrome | Safari | Firefox | Edge | Samsung Internet | Opera | Other
  os      String? // iOS | Android | Windows | macOS | Linux | Other

  // Traffic-source inputs — client-supplied (only the browser knows
  // document.referrer and the landing URL's query string), captured once at
  // first touch per session (lib/track.ts) and resent on every track() call
  // so every row in a session carries the same "how did they arrive"
  // attribution. Stored raw; AnalyticsReportService buckets these into a
  // direct/search/social/referral/campaign category on read rather than
  // persisting a derived label that could drift from the categorization
  // logic.
  referrerHost String? // hostname of document.referrer, when set
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  landingPath  String? // first page path of the session
  // Meta's {{site_source_name}} dynamic URL param — resolves to "fb"/"ig" at
  // click time, so it's the one reliable way to split Facebook vs Instagram
  // traffic (utm_source alone is set to a fixed campaign-level value like
  // "meta" for both placements). Same capture pattern as the utm* fields.
  siteSource String?

  // Geography — looked up server-side from the request IP (TrackService,
  // via the offline geoip-lite database) and stored as the resolved
  // labels, never the raw IP itself, same "derive once, store the label"
  // move as device/browser/os above.
  geoCountry String?
  geoRegion  String?
  geoCity    String?

  @@index([type, createdAt])
  @@index([eventId])
  @@index([sessionId])
}
