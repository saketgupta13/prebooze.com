DATABASE_URL="postgresql://saketgupta@localhost:5432/prebooze"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="dev-only-change-in-production"
PORT=4000
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
# WhatsApp via AiSensy (empty = dev provider; OTPs are logged, and returned in dev responses)
AISENSY_API_KEY=""
# Placeholder admin gate for /admin/kyc etc — swap for real staff auth later (see BACKEND.md)
ADMIN_API_SECRET="dev-admin-secret"
# Guest ID verification vendor (empty = dev stub, basic file sanity checks only).
# Elevated roles (organizer/promoter/lineup/venue) are manual-only and never call this.
KYC_VENDOR_API_KEY=""
# Razorpay (empty = dev stub — orders/payments/refunds/subscriptions all
# simulate instantly, no live gateway needed; POST /webhooks/razorpay trusts
# any payload in dev mode too, for local testing without a real webhook secret)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set once the Razorpay webhook is configured in the dashboard (Settings ->
# Webhooks -> add https://<your-api-host>/v1/webhooks/razorpay, subscribe to
# every subscription.* event) — this is the secret shown there, NOT the API
# key/secret pair above. Required once RAZORPAY_KEY_ID/SECRET are live.
RAZORPAY_WEBHOOK_SECRET=""
# Used to build the waitlist-offer WhatsApp link (e.g. https://prebooze.com)
WEB_APP_URL="http://localhost:5173"
# Used to build "sign in" links in staff-invite / weekly-summary emails
ADMIN_APP_URL="http://localhost:5174"
# Email via Resend (empty = dev provider; every email just logs to console instead of sending).
# Get a key at resend.com -> API Keys -> Create API Key (starts with "re_" -
# the Domain ID/Key ID shown elsewhere in the dashboard is NOT this value).
# Verify the sending domain's SPF/DKIM records there too, then set:
RESEND_API_KEY=""
EMAIL_FROM="Prebooze <noreply@prebooze.com>"
# Optional — real replies to an automated noreply@ address land here instead
# of vanishing. A real monitored inbox (e.g. your Workspace info@), not noreply@ itself.
EMAIL_REPLY_TO="info@prebooze.com"
