# ---------- Prebooze web — environment configuration ----------
# Leave VITE_API_URL empty to run fully offline on mock data (current mode).
# Point it at the backend and every typed endpoint in src/api goes live.
VITE_API_URL=

# Payments (Razorpay checkout key — public key only; secrets stay server-side)
VITE_RAZORPAY_KEY_ID=

# WhatsApp messaging — sent server-side via AiSensy (Meta BSP); the API key
# lives only in prebooze-api/.env, never in the frontend
VITE_WA_PROVIDER=aisensy

# Email (Resend / SES / SendGrid)
VITE_EMAIL_PROVIDER=resend
VITE_EMAIL_FROM="Prebooze <no-reply@prebooze.com>"

# Geo detection (reverse geocoding falls back to BigDataCloud's free client API)
VITE_GEOCODER_URL=https://api.bigdatacloud.net/data/reverse-geocode-client
